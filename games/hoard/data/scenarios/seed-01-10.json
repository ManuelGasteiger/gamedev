      "theme:faith",
      "faction:$court",
      "tone:grim"
    ],
    "text": {
      "lang": "en",
      "headline": "The inquisition of {court.name}",
      "body": "{priest.name} has the court's mages in chains and its archive under seal. The charge is dark craft at the throne; the proof is thin and the fires are not. The mage guild's work has stopped. A court that burns its own scholars is weaker for a generation, and it knows who it blames.",
      "because": "The secret you planted in {court.name} surfaced; a devout court with a weak crown answers with fire.",
      "variants": [
        {
          "id": "agent",
          "if": "bound(agent)",
          "body": "{priest.name} has {agent.name}'s tutors in chains and the archive under seal. The charge is dark craft at the throne, and this time the proof is not thin. The mages' work has stopped. {agent.subj} has not been named yet."
        }
      ]
    },
    "options": [
