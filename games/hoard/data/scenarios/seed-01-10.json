      {
        "id": "eat",
        "label": "Eat them",
        "act": {
          "type": "receive",
          "payload": {
            "outcome": "eat"
          }
        }
      },
      {
        "id": "ignore",
        "label": "Let them wait and go home",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "outcomes": {
