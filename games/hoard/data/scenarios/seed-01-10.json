          "is": "neighbour_of($court)",
          "at_war": false,
          "choose": "by_score:wealth"
        }
      },
      "envoy": {
        "person": {
          "court": "$match",
          "role": "envoy",
          "choose": "by_score:cunning"
        },
        "noun": "envoy",
        "sex": "any",
        "optional": true
      }
    },
    "require": [
      "court.cohesion >= 0.5",
      "match.cohesion >= 0.5"
    ],
    "salience": [
      {
        "if": "dragon.lore >= 15",
        "w": 3
      },
      {
        "if": "court.awe >= 0.3",
        "w": 1
      }
    ],
    "tags": [
      "theme:succession",
      "theme:hostage",
      "faction:$court",
      "faction:$match"
    ],
    "text": {
      "lang": "en",
      "headline": "Two crowns and {heir.noun:indef}",
      "body": "{court.name} has no one for the throne but {heir.name}, asleep in your hoard, and {match.name} has a widowed queen and a long border. Both courts have written to each other; neither has written to you. A marriage would make one realm of two, and the mountain would stand between it and nothing.",
      "because": "You hold {heir.name}; a marriage between the two courts needs {heir.obj}.",
      "variants": [
        {
          "id": "envoy",
          "if": "bound(envoy)",
          "body": "{envoy.name} of {match.name} has come to ask, very carefully, whether {heir.name} is well, and whether the mountain has views on marriage."
        }
      ]
    },
    "options": [
      {
        "id": "broker",
        "label": "Broker the marriage yourself",
        "act": {
          "type": "broker",
          "target": "$court",
          "secondary": "$match",
          "payload": {
            "pact": "marriage"
          }
        },
        "gate": "dragon.lore >= 15"
      },
      {
        "id": "release",
        "label": "Send {heir.noun:def} home under oath",
        "act": {
          "type": "release",
          "target": "$heir",
          "payload": {
            "terms": {
              "parties": [
                "dragon",
                "$court"
              ],
              "clauses": [
                {
                  "who": "them",
                  "pred": "tribute"
                }
              ]
            }
          }
        }
      },
      {
        "id": "ignore",
        "label": "Keep {heir.noun:def} and the border open",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "followup": {
      "seek": [
        "theme:succession"
      ],
      "after_wakings": 2
    },
    "provenance": {
      "gen": "hand",
      "model": "",
      "cell": "any/world/succession",
      "bank": "seed",
      "reviewed": true
    }
  },
  {
