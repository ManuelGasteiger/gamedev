    "text": {
      "lang": "en",
      "headline": "The cup is on their table",
      "body": "{cup.name:def} that lay under your left wing is now the centrepiece of {court.name}'s feast table, and the whole city has been quieter since. The thief has a street named after the walk back down. The city is rich, pleased with itself, and watching the sky more than it used to.",
      "because": "A court that does not fear you sent a thief while you slept; it remembers the theft with pride.",
      "variants": [
        {
          "id": "thief",
          "if": "bound(thief)",
          "body": "{thief.name} came out of your mountain with {cup.name:def} and has not bought a drink since. {cup.subj} stands on {court.name}'s feast table and the city watches the sky more than it used to."
        }
      ]
    },
    "options": [
      {
        "id": "take",
        "label": "Take {cup.name:def} back, and more",
        "act": {
          "type": "take",
          "target": "$court",
          "magnitude": 0.3,
          "payload": {
            "item": "$cup"
          }
        }
      },
      {
        "id": "demand",
        "label": "Demand the thief as hostage",
        "act": {
          "type": "demand",
          "target": "$court",
          "payload": {
            "clause": "hostage"
          }
        },
        "gate": "dragon.lore >= 3"
      },
      {
        "id": "gift",
        "label": "Send them exactly what else was taken",
        "act": {
          "type": "give",
          "target": "$court",
          "payload": {
            "gold": 40
          }
        }
      },
      {
        "id": "ignore",
        "label": "Let them keep {cup.name:def}",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "outcomes": {
      "gift": [
        {
          "reveal_to_player": "Generosity after a theft is remembered as a riddle; the court will send someone to ask what you meant."
        }
      ]
    },
