      "ending:lichdom",
      "tone:ominous"
    ],
    "text": {
      "lang": "en",
      "headline": "{crown.name:def} speaks",
      "body": "{crown.subj} waits until the cave is quiet. The living will always build cannon, {crown.subj} says, in the voice of the king who drowned wearing {crown.obj}. {crown.subj} can make you something cannon cannot reach. {crown.subj} does not say what that costs. {crown.subj} never does.",
      "because": "An artifact with its own purpose has been in the hoard long enough to learn your fears.",
      "variants": [
        {
          "id": "armed",
          "if": "bound(armed)",
          "body": "{crown.subj} waits until the cave is quiet. {armed.name} has cannon now, {crown.subj} says, in the voice of the king who drowned wearing {crown.obj}, and the living will always build more. {crown.subj} can make you something cannon cannot reach. {crown.subj} does not say what that costs."
        },
        {
          "id": "dead",
          "if": "bound(dead)",
          "body": "{crown.subj} waits until the cave is quiet. The dead of {dead.name} have priests now, {crown.subj} says, and the priests have a rite. {crown.subj} can make you something the living cannot kill. {crown.subj} does not say what you would be afterwards."
        }
      ]
    },
    "options": [
      {
        "id": "ask",
        "label": "Ask what {crown.subj} wants",
        "act": {
          "type": "commune",
          "target": "$crown",
          "payload": {
            "answer": "ask"
          }
        }
      },
      {
        "id": "accept",
        "label": "Accept the crown's bargain",
        "act": {
          "type": "commune",
          "target": "$crown",
          "payload": {
            "answer": "accept"
          }
        },
        "gate": "dragon.arcana >= 15"
      },
      {
        "id": "refuse",
        "label": "Refuse {crown.obj}",
        "act": {
          "type": "commune",
          "target": "$crown",
          "payload": {
            "answer": "refuse"
          }
        }
      },
      {
        "id": "gift",
        "label": "Give {crown.obj} to the dead and be rid of {crown.obj}",
        "act": {
          "type": "give",
          "target": "$dead",
          "payload": {
            "item": "$crown"
          }
        },
        "gate": "bound(dead)"
      },
      {
        "id": "ignore",
        "label": "Say nothing",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "followup": {
