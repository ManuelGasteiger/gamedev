[
  {
    "id": "scribe_among_hostages",
    "kind": "consequence",
    "stakes": "minor",
    "eras": [
      "iron",
      "castles",
      "gunpowder",
      "arcane"
    ],
    "weight": 100,
    "once": "run",
    "cooldown": null,
    "exclusive_group": null,
    "roles": {
      "a": {
        "act": {
          "type": "take_hostage",
          "age_wakings": [
            0,
            1
          ]
        }
      },
      "court": {
        "faction": {
          "is": "owner_of($a.target)",
          "remembers": "$a",
          "era_min": 2
        }
      },
      "hostage": {
        "person": {
          "court": "lair",
          "role": "hostage",
          "choose": "most_recent"
        },
        "noun": "hostage",
        "sex": "any"
      },
      "scribe": {
        "person": {
          "court": "lair",
          "role": "hostage",
          "trait": "curious",
          "choose": "by_score:renown"
        },
        "noun": "scribe",
        "sex": "any",
        "optional": true
      }
    },
    "require": [
      "court.has_library == true",
      "lair.has_historian == false"
    ],
    "salience": [
      {
        "if": "dragon.lore >= 3",
        "w": 3
      },
      {
        "if": "bound(scribe)",
        "w": 3
      }
    ],
    "tags": [
      "theme:hostage",
      "theme:memory",
      "faction:$court"
    ],
    "text": {
      "lang": "en",
      "headline": "{hostage.noun:scribe.indef} among the hostages",
      "body": "{hostage.name} of {court.name} has spent the days since the taking writing on the cave wall with a burnt stick: the names of the dead at {a.place}, the year, the weather. Asked why, {hostage.subj} says someone should keep the record, and that nobody else here can read.",
      "because": "You took {hostage.name} at {a.place} {a.years_ago:year} ago; {court.name} keeps a library, so its people are lettered.",
      "variants": [
        {
          "id": "scribe",
          "if": "bound(scribe)",
          "body": "{scribe.name} of {court.name} has covered the cave wall in charcoal: the names of the dead at {a.place}, the year, the weather. {scribe.subj} offers, without being asked, to keep your chronicle. Nobody else here can read."
        }
      ]
    },
    "options": [
      {
        "id": "keep",
        "label": "Keep {hostage.noun:scribe.def} as {hostage.noun:historian.poss2}",
        "act": {
          "type": "keep",
          "target": "$hostage",
          "payload": {
            "role": "historian"
          }
        },
        "gate": "dragon.lore >= 3"
      },
      {
        "id": "release",
        "label": "Send {hostage.noun:scribe.def} home",
        "act": {
          "type": "release",
          "target": "$hostage"
        }
      },
      {
        "id": "kill",
        "label": "Silence the record",
        "act": {
          "type": "kill",
          "target": "$hostage",
          "magnitude": 0.05
        }
      },
      {
        "id": "ignore",
        "label": "Let the writing stay on the wall",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "outcomes": {
      "keep": [
        {
          "history": {
            "person": "$hostage",
            "line": "kept_as_historian",
            "severity": 2
          }
        },
        {
          "reveal_to_player": "From now on the briefing tells you why, not only what, while this one lives."
        }
      ],
      "release": [
        {
          "history": {
            "person": "$hostage",
            "line": "released_unharmed",
            "severity": 1
          }
        }
      ]
    },
    "followup": {
      "seek": [
        "theme:memory"
      ],
      "after_wakings": 1
    },
    "provenance": {
      "gen": "hand",
      "model": "",
      "cell": "any/consequence/take_hostage",
      "bank": "seed",
      "reviewed": true
    }
  },
  {
    "id": "burned_library_scribes",
    "kind": "consequence",
    "stakes": "minor",
