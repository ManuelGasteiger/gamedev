      "faction:$court",
      "tone:tender"
    ],
    "text": {
      "lang": "en",
      "headline": "Pilgrims at the foot of the mountain",
      "body": "Eleven of {court.name}'s faithful have come up the pass in the snow with a cart of {home.name}'s last apples and a child who will not stop looking at the cave. They do not ask for anything. They have come to be looked at.",
      "because": "{court.name} holds you in awe and the road from {home.name} is open.",
      "variants": [
        {
          "id": "leader",
          "if": "bound(leader)",
          "body": "{leader.name} has led eleven of {court.name}'s faithful up the pass in the snow with a cart of {home.name}'s last apples. They do not ask for anything. They have come to be looked at, and {leader.subj} has brought a book to write down what they see."
        },
        {
          "id": "dread",
          "if": "court.dread >= 0.5",
          "body": "Eleven of {court.name}'s faithful have come up the pass in the snow. They walk slowly and keep the children at the back. They have brought the last apples from {home.name}, and they have not decided whether this is a gift or a tribute."
        }
      ]
    },
    "options": [
      {
        "id": "receive",
        "label": "Land and receive them",
        "act": {
          "type": "receive",
          "payload": {
            "outcome": "receive"
          }
        }
      },
      {
        "id": "bless",
        "label": "Bless their fields instead of appearing",
        "act": {
          "type": "bless",
          "target": "$home",
          "payload": {
