    ],
    "tags": [
      "theme:memory",
      "theme:library",
      "faction:$court"
    ],
    "text": {
      "lang": "en",
      "headline": "The scribes of {court.name}",
      "body": "{envoy.name} stands at the ledge with a satchel of ash. {a.years_ago:year} after you burned the library at {a.place}, {court.name} has no record of its own kings, and the young are taught from memory by the old. {envoy.noun:def} asks for what you took, or for someone to teach them letters again.",
      "because": "{court.name} lost its written memory at {a.place}; what it knows of you is now told, not read.",
      "variants": [
        {
          "id": "sage",
          "if": "bound(sage)",
          "body": "{sage.name}, the last {sage.noun} of {court.name}, has sent {envoy.name} with a satchel of ash from {a.place}. The hold has no record of its own kings now. {sage.noun:def} asks for the books you took, or for letters to be taught again."
        }
      ]
    },
    "options": [
      {
        "id": "books",
        "label": "Give back the books",
        "act": {
          "type": "give",
          "target": "$court",
          "payload": {
            "books": 1
          }
        }
      },
      {
        "id": "teach",
        "label": "Teach them letters",
        "act": {
          "type": "teach",
          "target": "$court",
          "payload": {
            "subject": "letters"
          }
        },
        "gate": "dragon.lore >= 3"
      },
      {
        "id": "eat",
        "label": "Eat {envoy.noun:def}",
        "act": {
          "type": "kill",
          "target": "$envoy",
          "magnitude": 0.05
        }
      },
      {
        "id": "ignore",
        "label": "Send them away",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "outcomes": {
      "ignore": [
        {
          "suppress": {
            "tag": "theme:library",
            "years": 100
          }
        }
      ],
      "teach": [
        {
          "history": {
            "person": "$envoy",
            "line": "taught_by_dragon",
            "severity": 2
          }
        }
      ]
    },
    "followup": {
      "seek": [
        "theme:memory"
      ],
      "after_wakings": 1
    },
    "provenance": {
      "gen": "hand",
      "model": "",
      "cell": "iron/consequence/burn",
      "bank": "seed",
      "reviewed": true
    }
