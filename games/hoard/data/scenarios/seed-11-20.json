        },
        "noun": "pretender",
        "sex": "any"
      }
    },
    "require": [
      "court.faith_share >= 0.2",
      "court.awe >= 0.2"
    ],
    "salience": [
      {
        "if": "court.has_temple == true",
        "w": 3
      },
      {
        "if": "dragon.dominion >= 8",
        "w": 1
      }
    ],
    "tags": [
      "theme:false_dragon",
      "theme:faith",
      "faction:$court",
      "tone:wry"
    ],
    "text": {
      "lang": "en",
      "headline": "{pretender.name} speaks for the mountain",
      "body": "{pretender.name} of {court.name} has announced that the mountain speaks to {pretender.obj} alone, and has raised the tithe in its name. The shrine's offerings go to the palace now. The faithful are uneasy and quiet. The sky has not confirmed or denied anything, which {pretender.name} calls agreement.",
      "because": "A long absence and a faithful court leave room for someone to hold your worship for you."
    },
    "options": [
      {
        "id": "judge",
        "label": "Descend and judge {pretender.noun:def}",
        "act": {
          "type": "judge",
          "target": "$pretender",
          "payload": {
            "verdict": "guilty"
          }
        },
        "gate": "dragon.lore >= 8"
      },
      {
        "id": "preach",
        "label": "Walk the city and correct the story",
        "act": {
          "type": "guise",
          "target": "$court",
          "payload": {
            "purpose": "preach"
          }
        },
        "gate": "dragon.arcana >= 15"
      },
      {
        "id": "miracle",
        "label": "Answer the faithful with a miracle",
        "act": {
          "type": "miracle",
          "target": "$court",
          "payload": {
            "kind": "protector"
          }
        },
        "gate": "dragon.dominion >= 3"
      },
      {
        "id": "burn",
        "label": "Burn the palace that collects your tithe",
        "act": {
          "type": "burn",
          "target": "$court",
          "magnitude": 0.3
        }
      },
      {
        "id": "ignore",
        "label": "Let {pretender.noun:def} keep the tithe",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "outcomes": {
      "ignore": [
        {
          "history": {
            "person": "$pretender",
            "line": "unchallenged_by_dragon",
            "severity": 2
          }
        }
      ]
    },
    "followup": {
      "seek": [
        "theme:faith",
        "theme:false_dragon"
      ],
      "after_wakings": 1
    },
    "provenance": {
      "gen": "hand",
      "model": "",
      "cell": "any/world/false_dragon",
