      },
      "elder": {
        "person": {
          "court": "$lost",
          "role": "sage",
          "choose": "by_score:age"
        },
        "noun": "elder",
        "sex": "any",
        "optional": true
      }
    },
    "require": [
      "lost.cohesion <= 0.5",
      "taker.dread <= 0.6"
    ],
    "salience": [
      {
        "if": "bound(empty)",
        "w": 3
      },
      {
        "if": "lost.awe >= 0.3",
        "w": 3
      }
    ],
    "tags": [
      "theme:refugees",
      "theme:war",
      "faction:$lost",
      "faction:$taker",
      "tone:solemn"
    ],
    "text": {
      "lang": "en",
      "headline": "A column on the pass road",
      "body": "Two hundred of {lost.name}'s people are on the road below with carts and no soldiers. {taker.name} has their valley. They have come to the mountain because the mountain is the one thing in the valley {taker.name} is afraid of. They will plant anywhere you point.",
      "because": "{lost.name} lost its land to {taker.name} and holds you in some awe; the mountain is the last door.",
      "variants": [
        {
          "id": "elder",
          "if": "bound(elder)",
          "body": "Two hundred of {lost.name}'s people are on the road below, led by {elder.name}, who remembers when you last flew over {lost.name} and has been telling the children about it for a week to keep them walking. They will plant anywhere you point."
        },
        {
          "id": "orc_taker",
          "if": "taker.race == orc",
          "body": "Two hundred of {lost.name}'s people are on the road below with carts and no soldiers. The orcs of {taker.name} have their valley and, by the smoke, their harvest. They have come to the mountain because the orcs will not. They will plant anywhere you point."
