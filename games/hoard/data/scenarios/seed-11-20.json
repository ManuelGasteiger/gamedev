    ],
    "text": {
      "lang": "en",
      "headline": "{kin.name} has come for {hostage.name}",
      "body": "{kin.name} of {court.name} has come up the pass alone, which took some courage, and stands at the ledge asking to see {hostage.name}. {kin.subj} has brought a ransom and a speech. The speech is about how long {hostage.name} has been gone and how the court needs {hostage.noun:heir.def}. The ransom is less than you would have asked.",
      "because": "{kin.name} knows where you are and is not too afraid to come.",
      "variants": [
        {
          "id": "bold",
          "if": "kin.trait == bold",
          "body": "{kin.name} of {court.name} has come up the pass alone and stands at the ledge demanding, not asking, to see {hostage.name}. {kin.subj} has brought a ransom and no speech. The ransom is fair."
        },
        {
          "id": "awe",
          "if": "court.awe >= 0.3",
          "body": "{kin.name} of {court.name} has come up the pass with a small offering for the shrine and a larger one for you, and asks to see {hostage.name} before anything is said about ransom. {kin.subj} kneels at the ledge, which {hostage.name} finds very funny."
        }
      ]
    },
