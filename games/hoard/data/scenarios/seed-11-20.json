[
  {
    "id": "dwarves_ask_for_fire",
    "kind": "audience",
    "stakes": "minor",
    "weight": 100,
    "once": "run",
    "cooldown": null,
    "exclusive_group": null,
    "arrival": {
      "who": "envoy",
      "from": "$hold",
      "needs": [
        "court.knows_lair",
        "court.dares",
        "court.motive"
      ]
    },
    "roles": {
      "hold": {
        "faction": {
          "race": "dwarf",
          "era_min": 2,
          "openness": [
            0.5,
            1.0
          ],
          "choose": "by_score:wealth"
        }
      },
      "foe": {
        "faction": {
          "race": "orc",
          "choose": "by_score:power"
        }
      },
      "envoy": {
        "person": {
          "court": "$hold",
          "role": "envoy",
          "choose": "by_score:cunning"
        },
        "noun": "envoy",
        "sex": "any"
      }
    },
    "require": [
      "hold.at_war == true",
      "hold.dread <= 0.5"
    ],
    "salience": [
      {
        "if": "hold.awe >= 0.3",
        "w": 3
      },
      {
        "if": "dragon.flame >= 8",
        "w": 1
      }
    ],
    "tags": [
      "theme:dwarves",
      "theme:war",
      "theme:orcs",
      "faction:$hold",
      "race:dwarf"
    ],
    "text": {
      "lang": "en",
      "headline": "The dwarves ask for fire",
      "body": "{envoy.name} of {hold.name} has brought a block of the hold's best steel as a gift and a request written in the Book: the orcs of {foe.name} have the lower galleries, and the hold's forges cannot make a heat that holds them. The dwarves do not ask you to burn anyone. They ask how fire is made to stay.",
      "because": "{hold.name} is at war with {foe.name} and open enough to ask a dragon for craft."
    },
    "options": [
      {
        "id": "teach",
        "label": "Teach their smiths the craft of lasting fire",
        "act": {
          "type": "teach",
          "target": "$hold",
          "payload": {
            "subject": "craft"
          }
        },
        "gate": "dragon.lore >= 3"
      },
      {
        "id": "gift",
        "label": "Give them a fire-touched relic",
        "act": {
          "type": "give",
          "target": "$hold",
          "payload": {
            "artifacts": 1
          }
        }
      },
      {
        "id": "burn",
        "label": "Burn the orcs out of the galleries yourself",
        "act": {
          "type": "burn",
          "target": "$foe",
          "magnitude": 0.4
        }
      },
      {
        "id": "ignore",
        "label": "Keep the steel, give nothing",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "outcomes": {
      "teach": [
        {
          "reveal_to_player": "Dwarves who learn fire from a dragon will one day sell engines that reach the clouds."
        }
      ]
    },
    "followup": {
      "seek": [
        "theme:dwarves",
        "theme:grudge"
      ],
      "after_wakings": 2
    },
    "provenance": {
      "gen": "hand",
      "model": "",
      "cell": "iron/audience/envoy/dwarf",
      "bank": "seed",
      "reviewed": true
    }
  },
  {
    "id": "quiet_valley",
    "kind": "omen",
    "stakes": "minor",
    "weight": 100,
    "once": "never",
    "cooldown": {
      "wakings": 6,
      "years": 100
    },
    "exclusive_group": null,
    "roles": {
      "i1": {
        "act": {
          "type": "ignore",
          "age_wakings": [
            0,
            0
          ]
        }
      },
      "i2": {
        "act": {
          "type": "ignore",
          "age_wakings": [
            1,
            1
          ]
        }
      },
      "i3": {
        "act": {
          "type": "ignore",
          "age_wakings": [
            2,
            2
          ]
        }
      },
      "court": {
        "faction": {
          "dread": [
            0.0,
            0.1
          ],
          "awe": [
            0.0,
            0.1
          ],
          "choose": "by_score:wealth"
        }
      }
    },
    "require": [
      "world.ignored_streak >= 3",
      "court.memory_tier <= oral"
    ],
    "salience": [
      {
        "if": "world.wakings >= 10",
        "w": 1
      }
    ],
    "tags": [
      "theme:quiet",
      "theme:forgetting",
      "faction:$court",
      "tone:wry"
    ],
    "text": {
      "lang": "en",
      "headline": "Nobody is looking at the mountain",
      "body": "Three wakings, three hooks left where they hung. In {court.name} the children are told the mountain has a dragon in it the way they are told the lake has a woman in it. A shepherd grazes goats on the lower slopes. The valley has stopped watching the sky, and it has stopped building things that point at it, too.",
      "because": "You have answered nothing for three wakings; what is not seen is not remembered.",
      "variants": [
        {
          "id": "third",
          "if": "bound(i3)",
          "body": "Three wakings, three hooks left where they hung. {court.name} tells its children the mountain has a dragon in it the way it tells them the lake has a woman in it. A shepherd grazes goats on your slopes. Nobody is building anything that points at the sky."
        },
        {
          "id": "late_era",
          "if": "court.era >= 3",
          "body": "Three wakings, three hooks left where they hung. {court.name} has stone walls and a clock tower now and does not look up at the mountain at all. Nobody is building anything that points at the sky. The engineers have other work."
        }
      ]
    },
    "options": [
      {
        "id": "show",
        "label": "Land in their square at noon",
        "act": {
          "type": "show",
          "target": "$court",
          "payload": {
            "kind": "land"
          }
        }
      },
      {
        "id": "preach",
        "label": "Walk among them and start a rumour",
        "act": {
          "type": "guise",
          "target": "$court",
          "payload": {
            "purpose": "preach"
          }
        },
        "gate": "dragon.arcana >= 15"
      },
      {
        "id": "ignore",
        "label": "Let them forget",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "outcomes": {
      "ignore": [
        {
          "reveal_to_player": "A forgotten dragon's next act is read as a first act; the forgetting is also an opening."
        }
      ]
    },
    "provenance": {
      "gen": "hand",
      "model": "",
      "cell": "any/omen/quiet",
      "bank": "seed",
      "reviewed": true
    }
  },
  {
    "id": "the_mountain",
    "kind": "lair",
    "stakes": "major",
    "weight": 100,
    "once": "run",
    "cooldown": null,
    "exclusive_group": null,
    "roles": {
      "settlers": {
        "faction": {
          "is": "neighbour_of(lair)",
          "choose": "by_score:awe"
        },
        "optional": true
      }
    },
    "require": [
      "dragon.might >= 400",
      "dragon.phase >= 4"
    ],
    "salience": [
      {
        "if": "bound(settlers)",
        "w": 3
      },
      {
        "if": "dragon.might >= 600",
        "w": 9
      }
    ],
    "tags": [
      "theme:mountain",
      "ending:mountain",
      "tone:solemn"
    ],
    "text": {
      "lang": "en",
      "headline": "The slopes are your shoulders",
      "body": "You have not fitted through the cave mouth for a hundred years. Snow stays on your back between wakings now. Goats graze on your tail. If you slept the long sleep here, the valley would build on you and call the mountain by your name, and no engine they ever make would reach your heart.",
      "because": "Might past a threshold and a long sleep make a dragon into a mountain.",
      "variants": [
        {
          "id": "settlers",
          "if": "bound(settlers)",
          "body": "You have not fitted through the cave mouth for a hundred years. {settlers.name} has a village on your lower slopes already; they think it is a hill. If you slept the long sleep here they would build a city on you and call the mountain by your name."
        }
      ]
    },
    "options": [
      {
        "id": "terraform",
        "label": "Raise the ground around you and settle in",
        "act": {
          "type": "terraform",
          "target": "$settlers",
          "payload": {
            "kind": "mountain"
          }
        },
        "gate": "dragon.might >= 600"
      },
      {
        "id": "demand",
        "label": "Demand that they come as pilgrims, not squatters",
        "act": {
          "type": "demand",
          "target": "$settlers",
          "payload": {
            "clause": "pilgrimage"
          }
        },
        "gate": "bound(settlers)"
      },
      {
        "id": "sleep",
        "label": "Sleep the long sleep, here, now",
        "act": {
          "type": "sleep",
          "payload": {
            "years": 3000,
            "wake_on": []
          }
        }
      },
      {
        "id": "ignore",
        "label": "Not yet",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "provenance": {
      "gen": "hand",
      "model": "",
      "cell": "arcane/lair/mountain",
      "bank": "seed",
      "reviewed": true
    }
  },
  {
    "id": "the_consort",
