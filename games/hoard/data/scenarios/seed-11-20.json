        "sex": "any"
      }
    },
    "require": [
      "lair.has_consort == false",
      "willing.trait != craven"
    ],
    "salience": [
      {
        "if": "willing.trait == bold",
        "w": 3
      },
      {
        "if": "court.awe >= 0.5",
        "w": 3
      }
    ],
    "tags": [
      "theme:consort",
      "faction:$court",
      "tone:tender"
    ],
    "text": {
      "lang": "en",
      "headline": "{willing.name} has followed you up the mountain",
      "body": "You walked {court.name}'s streets in a borrowed shape and {willing.name} walked with you, and knew, and came anyway. {willing.subj} is standing at the cave mouth now, with a travelling bag and the expression of someone who has already decided. Mortals age while you sleep. {willing.subj} knows that too.",
      "because": "You went among them in guise this waking; one of them saw through it and chose you."
    },
    "options": [
      {
        "id": "keep",
        "label": "Keep {willing.name} as {willing.noun:poss2}",
        "act": {
          "type": "keep",
          "target": "$willing",
          "payload": {
            "role": "consort"
          }
        },
        "gate": "dragon.lore >= 8"
      },
      {
        "id": "dismiss",
        "label": "Send {willing.obj} down the mountain, kindly",
        "act": {
          "type": "dismiss",
          "target": "$willing"
        }
      },
      {
        "id": "release",
        "label": "Send {willing.obj} home under your protection",
        "act": {
          "type": "release",
          "target": "$willing",
          "payload": {
            "terms": {
              "parties": [
                "dragon",
                "$court"
              ],
              "clauses": [
                {
                  "who": "dragon",
                  "pred": "defend"
                }
              ]
            }
          }
        }
      },
      {
        "id": "ignore",
        "label": "Leave {willing.obj} at the cave mouth",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "outcomes": {
      "keep": [
        {
          "history": {
            "person": "$willing",
            "line": "chose_the_dragon",
            "severity": 3
          }
        }
      ]
    },
    "followup": {
      "seek": [
        "theme:consort",
        "theme:succession"
      ],
      "after_wakings": 1
    },
    "provenance": {
      "gen": "hand",
      "model": "",
      "cell": "any/lair/consort",
      "bank": "seed",
      "reviewed": true
    }
  },
  {
    "id": "false_dragon",
    "kind": "world",
    "stakes": "major",
    "weight": 100,
    "once": "run",
    "cooldown": null,
    "exclusive_group": null,
    "roles": {
      "court": {
        "faction": {
          "has_tag": [
            "false_dragon"
          ],
          "choose": "most_recent"
        }
      },
      "pretender": {
