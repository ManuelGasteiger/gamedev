    ],
    "chance": 1,
    "cooldown_decades": 1,
    "object": "$person",
    "branches": [
      {"if": [{"field": "regions", "lt": 2}], "text_key": "purge_fall", "effects": [{"do": "fall", "person": "person", "reason": "purged"}, {"do": "untag", "tag": "inquisition:$person"}]},
      {"weight": 0.5, "text_key": "purge_civil_war", "effects": [{"do": "split", "war": 1, "bind": "new"}, {"do": "untag", "tag": "inquisition:$person"}]},
      {"weight": 0.5, "text_key": "purge_fall", "effects": [{"do": "fall", "person": "person", "reason": "purged"}, {"do": "untag", "tag": "inquisition:$person"}]}
    ]
  }
