      {"do": "field", "field": "militarism", "add": 0.1},
      {"do": "field", "on": "other", "field": "militarism", "add": 0.1},
      {"do": "field", "field": "era_progress", "add": 5},
      {"do": "field", "on": "other", "field": "era_progress", "add": 5}
    ]
  },
  {
