      {"do": "field", "field": "era_progress", "add": 5},
      {"do": "field", "on": "other", "field": "era_progress", "add": 5},
      {"do": "spawn_person", "role": "hero", "tags": ["warleader"], "bind": "leader"},
      {"do": "war", "against": "other", "reason": "old_enemies"}
    ]
