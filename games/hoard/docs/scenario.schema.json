{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hoard/scenario/v1",
  "title": "Hoard scenario v1",
  "description": "A unit of briefing content: when it fires (roles over the act log and world state), what it shows, which acts the player may answer with. See scenario-spec.md. Option acts are act templates; after role binding they must validate against act-api.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "stakes",
    "roles",
    "text",
    "options",
    "tags",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "kind": {
      "enum": [
        "consequence",
        "audience",
        "world",
        "lair",
        "omen"
      ]
    },
    "stakes": {
      "enum": [
        "minor",
        "major",
        "must"
      ]
    },
    "eras": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "bronze",
          "iron",
          "castles",
          "gunpowder",
          "arcane"
        ]
      }
    },
    "weight": {
      "enum": [
        1,
        10,
        20,
        50,
        100,
        200,
        500
      ],
      "default": 100
    },
    "once": {
      "enum": [
        "run",
        "world",
        "never"
      ],
      "default": "run"
    },
    "cooldown": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "wakings",
        "years"
      ],
      "properties": {
        "wakings": {
          "type": "integer",
          "minimum": 1
        },
        "years": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "exclusive_group": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "arrival": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "who",
        "from",
        "needs"
      ],
      "properties": {
        "who": {
          "enum": [
            "envoy",
            "pilgrim",
            "thief",
            "refugee",
            "hero",
            "prophet",
            "kin",
            "scholar"
          ]
        },
        "from": {
          "$ref": "#/$defs/roleRef"
        },
        "needs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,23}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    },
    "require": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predicate"
      }
    },
    "forbid": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/predicate"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "act"
            ],
            "properties": {
              "act": {
                "$ref": "#/$defs/actPattern"
              }
            }
          }
        ]
      }
    },
    "salience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "if",
          "w"
        ],
        "properties": {
          "if": {
            "$ref": "#/$defs/predicate"
          },
          "w": {
            "enum": [
              1,
              3,
              9
            ]
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(theme|race|ending|tone):[a-z][a-z0-9_]*$|^faction:\\$[a-z][a-z0-9_]*$"
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "body"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "minLength": 20,
          "maxLength": 700
        },
        "because": {
          "type": "string",
          "maxLength": 220
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "if",
              "body"
            ],
            "properties": {
              "if": {
                "$ref": "#/$defs/predicate"
              },
              "headline": {
                "type": "string",
                "maxLength": 80
              },
              "body": {
                "type": "string",
                "maxLength": 700
              }
            }
          }
        },
        "results": {
          "type": "object",
          "description": "optional result line per option id, shown after the act resolves",
          "additionalProperties": {
            "type": "string",
            "maxLength": 280
          }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/option"
      },
      "contains": {
        "type": "object",
        "properties": {
          "act": {
            "type": "object",
            "properties": {
              "type": {
                "const": "ignore"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "act"
        ]
      }
    },
    "outcomes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/outcome"
        }
      }
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seek"
      ],
      "properties": {
        "seek": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^theme:[a-z][a-z0-9_]*$"
          }
        },
        "after_wakings": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gen",
        "cell",
        "bank"
      ],
      "properties": {
        "gen": {
          "enum": [
            "llm",
            "hand",
            "llm_edited"
          ]
        },
        "model": {
          "type": "string"
        },
        "cell": {
          "type": "string"
        },
        "bank": {
          "type": "string"
        },
        "reviewed": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "audience"
          }
        }
      },
      "then": {
        "required": [
          "arrival"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "once": {
            "const": "never"
          }
        }
      },
      "then": {
        "required": [
          "cooldown"
        ],
        "properties": {
          "cooldown": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "roleRef": {
      "type": "string",
      "pattern": "^\\$[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "intRange": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "predicate": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "description": "clause (' and ' clause)*; clause := path op value | bound(role) | has_tag(role, tag) | not clause. Paths come from data/scenarios/vocab.json; the lint step parses this."
    },
    "actType": {
      "enum": [
        "burn",
        "kill",
        "crush",
        "fight",
        "destroy_altar",
        "take",
        "take_hostage",
        "hunt",
        "receive",
        "defend",
        "give",
        "release",
        "bless",
        "ward",
        "show",
        "demand",
        "swear",
        "teach",
        "incite",
        "broker",
        "reveal",
        "judge",
        "accept_offering",
        "consecrate",
        "miracle",
        "curse",
        "corrupt",
        "raise_undead",
        "haunt",
        "commune",
        "keep",
        "dismiss",
        "build",
        "terraform",
        "sponsor",
        "guise",
        "sleep",
        "pick_talent",
        "ignore",
        "exit"
      ]
    },
    "actPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "oneOf": [
            {
              "$ref": "#/$defs/actType"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/actType"
              }
            }
          ]
        },
        "structure": {
          "enum": [
            "library",
            "temple",
            "foundry",
            "walls",
            "altar",
            "granary",
            "tower"
          ]
        },
        "payload_has": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "magnitude": {
          "$ref": "#/$defs/range"
        },
        "age_wakings": {
          "$ref": "#/$defs/intRange"
        },
        "age_years": {
          "$ref": "#/$defs/intRange"
        },
        "source": {
          "enum": [
            "raid",
            "lair",
            "sleep",
            "scenario",
            "hook"
          ]
        },
        "answers": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/roleRef"
        },
        "after": {
          "$ref": "#/$defs/roleRef"
        },
        "before": {
          "$ref": "#/$defs/roleRef"
        }
      }
    },
    "chooser": {
      "type": "string",
      "pattern": "^(most_recent|random|by_score:(renown|cunning|piety|wealth|dread|awe|power|age))$"
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "optional": {
          "type": "boolean",
          "default": false
        },
        "act": {
          "$ref": "#/$defs/actPattern"
        },
        "faction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "is": {
              "type": "string",
              "maxLength": 120
            },
            "remembers": {
              "$ref": "#/$defs/roleRef"
            },
            "era_min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "era_max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "race": {
              "type": "string"
            },
            "dread": {
              "$ref": "#/$defs/range"
            },
            "awe": {
              "$ref": "#/$defs/range"
            },
            "at_war": {
              "type": "boolean"
            },
            "has_tag": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "choose": {
              "$ref": "#/$defs/chooser"
            },
            "piety": {
              "$ref": "#/$defs/range"
            },
            "openness": {
              "$ref": "#/$defs/range"
            },
            "cohesion": {
              "$ref": "#/$defs/range"
            },
            "knows_prophecy": {
              "type": "boolean"
            },
            "has_slayers": {
              "type": "boolean"
            },
            "has_temple": {
              "type": "boolean"
            },
            "has_library": {
              "type": "boolean"
            },
            "slayer_stage": {
              "enum": [
                "none",
                "forming",
                "ready",
                "marching"
              ]
            },
            "memory_tier_min": {
              "enum": [
                "oral",
                "written",
                "monumental"
              ]
            }
          }
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": {
              "oneOf": [
                {
                  "$ref": "#/$defs/roleRef"
                },
                {
                  "const": "none"
                }
              ]
            },
            "terrain": {
              "type": "array",
              "items": {
                "enum": [
                  "vale",
                  "marches",
                  "hills",
                  "wood",
                  "fen",
                  "scar",
                  "lair"
                ]
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "burn": {
              "$ref": "#/$defs/range"
            },
            "adjacent_to": {
              "$ref": "#/$defs/roleRef"
            },
            "choose": {
              "$ref": "#/$defs/chooser"
            },
            "has_structure": {
              "enum": [
                "library",
                "temple",
                "foundry",
                "walls",
                "altar",
                "granary",
                "tower"
              ]
            }
          }
        },
        "person": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "court": {
              "oneOf": [
                {
                  "$ref": "#/$defs/roleRef"
                },
                {
                  "const": "lair"
                }
              ]
            },
            "role": {
              "enum": [
                "ruler",
                "heir",
                "hero",
                "sage",
                "priest",
                "envoy",
                "hostage",
                "consort",
                "historian",
                "champion",
                "ward"
              ]
            },
            "tag": {
              "type": "string"
            },
            "trait": {
              "type": "string"
            },
            "alive": {
              "type": "boolean",
              "default": true
            },
            "knows_dragon": {
              "type": "boolean"
            },
            "memory_has": {
              "type": "string"
            },
            "choose": {
              "$ref": "#/$defs/chooser"
            },
            "is_lie": {
              "type": "boolean"
            },
            "renown": {
              "$ref": "#/$defs/range"
            },
            "cunning": {
              "$ref": "#/$defs/range"
            },
            "age": {
              "$ref": "#/$defs/intRange"
            }
          }
        },
        "item": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in": {
              "enum": [
                "hoard",
                "court",
                "person"
              ]
            },
            "agenda": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "choose": {
              "$ref": "#/$defs/chooser"
            }
          }
        },
        "remnant": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "race": {
              "type": "string"
            },
            "strength": {
              "$ref": "#/$defs/range"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "act"
          ]
        },
        {
          "required": [
            "faction"
          ]
        },
        {
          "required": [
            "region"
          ]
        },
        {
          "required": [
            "person"
          ]
        },
        {
          "required": [
            "item"
          ]
        },
        {
          "required": [
            "remnant"
          ]
        }
      ]
    },
    "actTemplate": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/actType"
        },
        "target": {
          "$ref": "#/$defs/roleRef"
        },
        "secondary": {
          "$ref": "#/$defs/roleRef"
        },
        "magnitude": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "const": "$slider"
            }
          ]
        },
        "payload": {
          "type": "object"
        },
        "structure": {
          "enum": [
            "library",
            "temple",
            "foundry",
            "walls",
            "altar",
            "granary",
            "tower"
          ],
          "description": "for burn: the structure aimed at; the runtime maps it to secondary {kind: structure, id}"
        }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "act"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "act": {
          "$ref": "#/$defs/actTemplate"
        },
        "gate": {
          "$ref": "#/$defs/predicate"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "suppress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "years"
          ],
          "properties": {
            "tag": {
              "type": "string"
            },
            "years": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "person",
            "line"
          ],
          "properties": {
            "person": {
              "$ref": "#/$defs/roleRef"
            },
            "line": {
              "type": "string"
            },
            "severity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        },
        "seek": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reveal_to_player": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}