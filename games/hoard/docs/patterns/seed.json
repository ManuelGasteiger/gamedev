          "slay_attempt",
          "order_disbanded",
          "slayer_killed"
        ],
        "subject": "?order",
        "within_years": 300
      }
    ],
    "unless": [
      {
        "between": [
          "a",
          "b"
        ],
        "kind": "collapse",
        "subject": "?court"
      }
    ],
    "unless_forever": [
      {
        "kind": "oath_sworn",
        "subject": "?court",
        "object": "dragon"
      }
    ],
    "once_per": [
      "?court"
    ],
    "outcome_by": {
      "c.kind": {
        "slayer_killed": "fell",
        "slay_attempt": "struck",
        "order_disbanded": "faded"
      }
    },
    "emit": {
      "kind": "story.vengeance",
      "subject": "?court",
      "object": "dragon",
      "magnitude": "max(a.magnitude, c.magnitude)",
