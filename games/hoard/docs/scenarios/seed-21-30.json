[
  {
    "id": "the_walls_went_up",
    "kind": "consequence",
    "stakes": "minor",
    "eras": [
      "iron",
      "castles",
      "gunpowder",
      "arcane"
    ],
    "weight": 100,
    "once": "run",
    "cooldown": null,
    "exclusive_group": null,
    "roles": {
      "a": {
        "act": {
          "type": "burn",
          "magnitude": [
            0.3,
            1.0
          ],
          "age_years": [
            20,
            150
          ]
        }
      },
      "court": {
        "faction": {
          "is": "owner_of($a.target)",
          "remembers": "$a",
          "has_tag": [
            "walls"
          ],
          "era_min": 2
        }
      },
      "mason": {
        "person": {
          "court": "$court",
          "role": "sage",
          "choose": "by_score:renown"
        },
        "optional": true
      }
    },
    "require": [
      "court.dread >= 0.3",
      "court.cohesion >= 0.4"
    ],
    "salience": [
      {
        "if": "court.era >= 3",
        "w": 1
      },
      {
        "if": "bound(mason)",
        "w": 3
      }
    ],
    "tags": [
      "theme:fire",
      "theme:war",
      "faction:$court",
      "tone:wry"
    ],
    "text": {
      "headline": "{court.name} has walls now",
      "body": "Where you burned {a.place} {a.years_ago} years ago there is stone to the height of a house and towers at the corners, each with a slot cut for a bolt-thrower that does not exist yet. The quarry is three valleys away. They have spent a generation's wealth on this, and they will tell you so if you land.",
      "because": "A court that remembers a burning and has reached the age of castles builds against the sky.",
      "variants": [
        {
          "if": "bound(mason)",
          "body": "{mason.name} of {court.name} designed the new walls at {a.place}, stone to the height of a house with a slot in every tower for a bolt-thrower that does not exist yet. {mason.pronoun} has written a treatise on dragon fire. It is mostly wrong."
        }
      ]
    },
    "options": [
      {
        "id": "walls",
        "label": "Burn the walls while they are new",
        "act": {
          "type": "burn",
          "target": "$court",
          "magnitude": 0.3,
          "structure": "walls"
        }
      },
      {
        "id": "demand",
        "label": "Demand they tear the towers down",
        "act": {
          "type": "demand",
          "target": "$court",
          "payload": {
            "clause": "tear_down"
          }
        },
        "gate": "dragon.lore >= 3"
      },
      {
        "id": "show",
        "label": "Land inside the walls, in the square",
        "act": {
          "type": "show",
          "target": "$court",
          "payload": {
            "kind": "land"
          }
        }
      },
      {
        "id": "ignore",
        "label": "Let them have their walls",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "outcomes": {
      "ignore": [
        {
          "reveal_to_player": "Walls that stand for an age become a court's pride; pride founds slayer orders."
        }
      ]
    },
    "followup": {
      "seek": [
        "theme:slayers",
        "theme:war"
      ],
      "after_wakings": 2
    },
    "provenance": {
      "gen": "hand",
      "model": "",
      "cell": "castles/consequence/burn",
      "bank": "seed",
      "reviewed": true
    }
  },
  {
    "id": "the_gold_you_took",
    "kind": "consequence",
    "stakes": "minor",
    "weight": 100,
    "once": "run",
    "cooldown": null,
    "exclusive_group": null,
    "roles": {
      "a": {
        "act": {
          "type": "take",
          "payload_has": [
            "gold"
          ],
          "magnitude": [
            0.3,
            1.0
          ],
          "age_wakings": [
            0,
            1
          ]
        }
      },
      "court": {
        "faction": {
          "is": "owner_of($a.target)",
          "remembers": "$a"
        }
      },
      "rival": {
        "faction": {
          "is": "neighbour_of($court)",
          "at_war": false,
          "choose": "by_score:power"
        }
      }
    },
    "require": [
      "court.cohesion <= 0.5",
      "rival.wealth_rank <= 2"
    ],
    "salience": [
      {
        "if": "court.at_war == true",
        "w": 3
      },
      {
        "if": "court.dread >= 0.4",
        "w": 1
      }
    ],
    "tags": [
      "theme:hoard",
      "theme:war",
      "faction:$court",
      "faction:$rival"
    ],
    "text": {
      "headline": "An empty treasury and a full neighbour",
      "body": "The gold you took from {court.name} {a.years_ago} years ago was the gold that paid its soldiers. The soldiers have gone to {rival.name}, which pays. {court.name}'s king now rules a city that cannot defend its own gates, and {rival.name} has noticed.",
      "because": "You took {a.size} of {court.name}'s wealth; a poor court cannot keep an army."
    },
    "options": [
      {
        "id": "give",
        "label": "Return a third of it, quietly",
        "act": {
          "type": "give",
          "target": "$court",
          "payload": {
            "gold": 60
          }
        }
      },
      {
        "id": "defend",
        "label": "Promise to stand between them",
        "act": {
          "type": "swear",
          "target": "$court",
          "payload": {
            "terms": {
              "parties": [
                "dragon",
                "$court"
              ],
              "clauses": [
                {
                  "who": "dragon",
                  "pred": "defend"
                },
                {
                  "who": "them",
                  "pred": "tribute"
                }
              ]
            }
          }
        }
      },
      {
        "id": "incite",
        "label": "Point {rival.name} at the open gates",
        "act": {
          "type": "incite",
          "target": "$rival",
          "secondary": "$court"
        },
        "gate": "dragon.lore >= 3"
      },
      {
        "id": "ignore",
        "label": "A poor court is a quiet court",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
    "followup": {
      "seek": [
        "theme:war"
      ],
      "after_wakings": 1
    },
    "provenance": {
      "gen": "hand",
      "model": "",
      "cell": "any/consequence/take",
      "bank": "seed",
      "reviewed": true
    }
  },
  {
