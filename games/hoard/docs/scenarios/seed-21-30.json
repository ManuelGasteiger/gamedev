      "tone:grim"
    ],
    "text": {
      "headline": "A road of cairns",
      "body": "The road from {a.place} to {court.name}'s capital is lined with cairns now, one for each company you burned on the march. {widow.name} rules a court of widows and boys. The boys are training with spears in the square, and the drill-master was there that day.",
      "because": "You killed {a.size} of {court.name}'s army at {a.place}; a martial court remembers its dead in stone.",
      "variants": [
        {
          "if": "bound(general)",
          "body": "{general.name} survived the march you burned at {a.place} and has not stopped talking about it. The road is lined with cairns. The boys drilling in {court.name}'s square call {general.pronoun} teacher."
        }
      ]
    },
    "options": [
      {
        "id": "crush",
        "label": "Finish the garrison before the boys grow",
        "act": {
          "type": "kill",
          "target": "$court",
          "magnitude": 0.5,
          "payload": {
            "who": "garrison"
          }
        }
      },
      {
        "id": "judge",
        "label": "Land and judge the drill-master",
        "act": {
          "type": "judge",
          "target": "$general",
          "payload": {
            "verdict": "spare"
          }
        },
        "gate": "bound(general)"
      },
      {
        "id": "give",
        "label": "Send grain for the widows",
        "act": {
          "type": "give",
          "target": "$court",
          "payload": {
            "food": 40
          }
        }
      },
      {
        "id": "ignore",
        "label": "Let them drill",
        "act": {
          "type": "ignore",
          "target": "$self"
        }
      }
    ],
